{
  "mcpServers": {
    "ls-workbench-observe": {
      "command": "uv",
      "args": ["run", "--project", "/absolute/path/to/workbench/mcp", "ls-workbench"],
      "env": {
        "UV_CACHE_DIR": "/absolute/path/to/workbench/.uv-cache",
        "UV_PYTHON_INSTALL_DIR": "/absolute/path/to/workbench/.uv-cache/python",
        "LS_WB_PROFILE": "observe"
      }
    },
    "ls-workbench-operate": {
      "command": "uv",
      "args": ["run", "--project", "/absolute/path/to/workbench/mcp", "ls-workbench"],
      "env": {
        "UV_CACHE_DIR": "/absolute/path/to/workbench/.uv-cache",
        "UV_PYTHON_INSTALL_DIR": "/absolute/path/to/workbench/.uv-cache/python",
        "LS_WB_PROFILE": "operate"
      }
    }
  }
}
